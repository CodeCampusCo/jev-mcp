# Copy to .env and fill in. .env is gitignored and must stay that way.
TYPESAFE_API_KEY=

# Optional. An Axiom ingest token turns on logging to the jev-mcp dataset, which
# must already exist in that account. Axiom drops writes to one that does not,
# and this server swallows the response, so a missing dataset looks like success.
# Leave it empty and nothing is logged; the server works the same either way.
AXIOM_API_KEY=

# Optional, rarely needed.
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# The model is pinned in the code. Set this to move it without a code change.
# `jev-latest` floats, which is what the pin exists to avoid.
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
