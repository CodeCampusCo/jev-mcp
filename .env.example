# Copy to .env and fill in. .env is gitignored and must stay that way.
TYPESAFE_API_KEY=

# Optional. An Axiom ingest token turns on logging to the jev-mcp dataset.
# Leave it empty and nothing is logged; the server works the same either way.
AXIOM_API_KEY=

# Optional, rarely needed.
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_DEFAULT_MODEL=jev-latest
